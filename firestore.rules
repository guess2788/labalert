rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /results/{resultId} {
      // Patients: can read ONE result only if they have its exact link/ID
      allow get: if true;
      // Only logged-in technicians can list all results (tracker page)
      allow list: if request.auth != null;
      // Only logged-in technicians can add or update results
      allow create, update: if request.auth != null;
      // Nobody can delete from the app
      allow delete: if false;
    }
  }
}
